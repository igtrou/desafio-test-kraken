        "X-Request-Id"
      ],
      "input_query_strings": [
        "provider",
        "type"
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/krakend/protocol/openid-connect/certs",
          "cache": true,
          "disable_jwk_security": true,
          "roles_key": "roles",
          "roles": [
            "reader",
            "moderator"
          ],
          "propagate_claims": [
            [
              "roles",
              "X-Auth-Roles"
            ],
            [
              "sub",
              "X-Auth-Subject"
            ]
          ]
        }
      },
      "backend": [
        {
          "host": [
            "http://laravel.test"
          ],
          "url_pattern": "/api/quotation/{symbol}",
          "encoding": "json",
          "extra_config": {
            "modifier/martian": {
              "fifo.Group": {
                "scope": [
                  "request"
                ],
                "modifiers": [
                  {
                    "header.Modifier": {
                      "scope": [
                        "request"
                      ],
                      "name": "X-Gateway-Secret",
                      "value": "krakend-internal"
                    }
                  },
                  {
                    "header.Modifier": {
                      "scope": [
                        "request"
                      ],
                      "name": "X-Gateway-Auth",
                      "value": "jwt"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
