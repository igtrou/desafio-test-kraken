{
  "$schema": "https://www.krakend.io/schema/v2.8/krakend.json",
  "version": 3,
  "name": "Laravel KrakenD Playground",
  "timeout": "5000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "X-Request-Id"
      ],
      "expose_headers": [
        "X-KrakenD-Complete",
        "X-Request-Id"
      ],
      "max_age": "12h",
      "allow_credentials": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://laravel.test"
          ],
          "url_pattern": "/dashboard/quotations",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/api/auth/token",
      "method": "POST",
      "input_headers": [
        "Content-Type",
        "X-Request-Id"
      ],
      "backend": [
        {
          "host": [
            "http://laravel.test"
          ],
          "url_pattern": "/api/auth/token",
          "encoding": "json",
          "extra_config": {
            "modifier/martian": {
              "header.Modifier": {
                "scope": [
                  "request"
                ],
                "name": "X-Gateway-Secret",
                "value": "krakend-internal"
              }
            }
          }
        }
      ]
    },
    {
      "endpoint": "/api/auth/token",
      "method": "DELETE",
